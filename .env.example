# Public build-time variables (safe to expose). Copy to .env.local for local builds.
NEXT_PUBLIC_SITE_URL=https://10peakstudios.com
# Pending PRD OQ-2 (supplied as Connect@10peakstudio.com; domain differs)
NEXT_PUBLIC_CONTACT_EMAIL=connect@10peakstudios.com
# Digits only, country code first. Empty hides every WhatsApp CTA (PRD OQ-3).
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_CF_WA_TOKEN=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_SHOW_TESTIMONIALS=false
# Set to "production" only for launch builds: the placeholder check then fails the build.
SITE_BUILD_ENV=preview
