# Public build-time environment variables.
# - For local development (npm run dev): copy to .env.local (Cloudflare test Turnstile keys allowed)
# - For local production builds & deployment (npm run deploy): copy to .env.production.local (REAL Turnstile key required)
# - For Cloudflare Workers Builds CI: configure in Cloudflare Dashboard -> Settings -> Build Variables
NEXT_PUBLIC_SITE_URL=https://10peakstudios.com
NEXT_PUBLIC_CONTACT_EMAIL=connect@10peakstudios.com
# Digits only, country code first (e.g. 917678083589). Empty hides WhatsApp CTA.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_CF_WA_TOKEN=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Cloudflare Turnstile Site Key (use real key for production, test key 1x00000000000000000000AA only in .env.local)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_SHOW_TESTIMONIALS=false
SITE_BUILD_ENV=production
