{
  // Architecture.md 5.2. /api/contact Worker ("main", D1, vars) configured for enquiry pipeline.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "10peakstudios-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/sitemap.xml", "/robots.txt"]
  },
  // Optional D1 Database: Uncomment and set database_id after creating database via `npx wrangler d1 create 10peakstudio-leads`
  // "d1_databases": [
  //   {
  //     "binding": "LEADS_DB",
  //     "database_name": "10peakstudio-leads",
  //     "database_id": "<real-database-id-from-cloudflare>"
  //   }
  // ],
  "vars": {
    "ENVIRONMENT": "production",
    "SITE_URL": "https://10peakstudios.com",
    "LEAD_NOTIFY_TO": "connect@10peakstudios.com",
    "LEAD_FROM": "10PeakStudio <connect@10peakstudios.com>",
    "ALLOWED_ORIGINS": "https://10peakstudios.com,https://www.10peakstudios.com",
    "TURNSTILE_EXPECTED_HOSTNAME": "10peakstudios.com,www.10peakstudios.com",
    "AUTO_REPLY_ENABLED": "true"
  },
  "observability": {
    "enabled": true
  }
}
